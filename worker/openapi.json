{
  "openapi": "3.1.0",
  "info": {
    "title": "India Verified Worker",
    "description": "AI-powered news verification and publishing pipeline",
    "version": "1.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health check",
        "description": "Returns a simple OK status to confirm the service is running.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Pipeline status",
        "description": "Returns the last pipeline run time, today's story count, and whether the pipeline is healthy (ran within last 45 minutes).",
        "operationId": "pipeline_status_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/reset-feeds": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Reset parked RSS feeds",
        "description": "Unparks all RSS feeds that were parked due to repeated failures. Returns the number of feeds that were unparked.",
        "operationId": "reset_feeds_reset_feeds_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetFeedsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/trigger": {
      "post": {
        "tags": [
          "trigger"
        ],
        "summary": "Manually trigger the news pipeline",
        "description": "Triggers a pipeline run with optional mode flags. Requires X-Admin-Token header. Returns immediately \u2014 the pipeline runs in a background thread.",
        "operationId": "trigger_pipeline_trigger_post",
        "parameters": [
          {
            "name": "X-Admin-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-Admin-Token"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/TriggerRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriggerResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing admin token"
          },
          "500": {
            "description": "Admin token not configured on server"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Reader assistant",
        "description": "Answers reader questions about India Verified using read-only, whitelisted lookups over published news data. Always returns HTTP 200 so the website can degrade gracefully; failures come back as a fixed fallback sentence.",
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid worker token"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 800,
            "minLength": 1,
            "title": "Message"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatTurn"
            },
            "type": "array",
            "maxItems": 8,
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply",
            "description": "The assistant's answer, or the fixed fallback sentence"
          },
          "degraded": {
            "type": "boolean",
            "title": "Degraded",
            "description": "True when the model chain was unavailable",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "reply"
        ],
        "title": "ChatResponse"
      },
      "ChatTurn": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 800,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatTurn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Always 'ok' when the service is running",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Worker version (matches the deployed build)",
            "default": "1.2.0"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "description": "ISO 8601 timestamp of the check"
          }
        },
        "type": "object",
        "required": [
          "timestamp"
        ],
        "title": "HealthResponse",
        "description": "Response from the /health endpoint."
      },
      "ResetFeedsResponse": {
        "properties": {
          "unparked": {
            "type": "integer",
            "title": "Unparked",
            "description": "Number of feeds that were unparked"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable status message"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "description": "ISO 8601 timestamp of the reset"
          }
        },
        "type": "object",
        "required": [
          "unparked",
          "message",
          "timestamp"
        ],
        "title": "ResetFeedsResponse",
        "description": "Response from the /reset-feeds endpoint."
      },
      "StatusResponse": {
        "properties": {
          "last_run_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Run At",
            "description": "ISO 8601 timestamp of the last pipeline run, or null if none"
          },
          "stories_today": {
            "type": "integer",
            "title": "Stories Today",
            "description": "Number of posts published today",
            "default": 0
          },
          "pipeline_healthy": {
            "type": "boolean",
            "title": "Pipeline Healthy",
            "description": "True if the pipeline ran within the last 45 minutes",
            "default": false
          },
          "last_cleanup_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Cleanup At",
            "description": "ISO 8601 timestamp of the last successful cleanup/archival run"
          },
          "cleanup_healthy": {
            "type": "boolean",
            "title": "Cleanup Healthy",
            "description": "True if cleanup ran within the last 12 hours",
            "default": false
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Worker version (matches the deployed build)",
            "default": "1.2.0"
          },
          "checked_at": {
            "type": "string",
            "title": "Checked At",
            "description": "ISO 8601 timestamp of this status check"
          }
        },
        "type": "object",
        "required": [
          "checked_at"
        ],
        "title": "StatusResponse",
        "description": "Detailed pipeline status including last run time and today's story count."
      },
      "TriggerRequest": {
        "properties": {
          "supplementary_only": {
            "type": "boolean",
            "title": "Supplementary Only",
            "description": "Only fetch from supplementary sources (GNews, NewsAPI)",
            "default": false
          },
          "archive_only": {
            "type": "boolean",
            "title": "Archive Only",
            "description": "Only run old-post archiving/cleanup",
            "default": false
          }
        },
        "type": "object",
        "title": "TriggerRequest",
        "description": "Optional parameters for triggering the pipeline."
      },
      "TriggerResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "Whether the pipeline was successfully triggered"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable status message"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "description": "ISO 8601 timestamp of the trigger attempt"
          }
        },
        "type": "object",
        "required": [
          "success",
          "message",
          "timestamp"
        ],
        "title": "TriggerResponse",
        "description": "Response from a pipeline trigger request."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
